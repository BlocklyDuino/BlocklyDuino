<xml>
  <block type="st_sd" x="25" y="25">
    <mutation uid="image_card" />
    <field name="NAME">card</field>
    <field name="CS">10</field>
    <comment pinned="false" w="480" h="240">Purpose: Write a high-depth RGB PPM with selected per-channel range. This format preserves precision beyond an 8-bit BMP channel.
Wiring: SPI SD card: CS D10; digital write: PIN D6; SPI MOSI D11, MISO D12, SCK D13; CS as listed. Common GND; use each module’s required supply.
Try: Change one colour-channel formula while keeping values within the configured range.</comment>
  </block>
  <block type="arduino_typed_variable" x="310" y="25">
    <field name="TYPE">uint32_t</field>
    <field name="VAR">levels</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">1024</field>
      </block>
    </value>
    <comment pinned="false" w="340" h="170">Create levels as uint32_t. Outside a body it is global; inside a function/setup/loop it belongs to that body. Its value input is the initial value.</comment>
  </block>
  <block type="arduino_setup_section" x="25" y="100">
    <statement name="DO">
      <block type="st_image_begin">
        <field name="DEVICE">image_card</field>
        <field name="FORMAT">PPM_RGB</field>
        <field name="MODE">STREAM</field>
        <value name="PATH">
          <block type="text">
            <field name="TEXT">COLOR.PPM</field>
          </block>
        </value>
        <value name="WIDTH">
          <block type="math_number">
            <field name="NUM">32</field>
          </block>
        </value>
        <value name="HEIGHT">
          <block type="math_number">
            <field name="NUM">32</field>
          </block>
        </value>
        <value name="LEVELS">
          <block type="variables_get">
            <field name="VAR">levels</field>
          </block>
        </value>
        <value name="RESERVE">
          <block type="logic_boolean">
            <field name="BOOL">FALSE</field>
          </block>
        </value>
        <next>
          <block type="controls_for">
            <field name="VAR">y</field>
            <value name="FROM">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <value name="TO">
              <block type="math_number">
                <field name="NUM">31</field>
              </block>
            </value>
            <value name="BY">
              <block type="math_number">
                <field name="NUM">1</field>
              </block>
            </value>
            <statement name="DO">
              <block type="controls_for">
                <field name="VAR">x</field>
                <value name="FROM">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <value name="TO">
                  <block type="math_number">
                    <field name="NUM">31</field>
                  </block>
                </value>
                <value name="BY">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="st_image_append_rgb">
                    <field name="DEVICE">image_card</field>
                    <value name="R">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR">x</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">33</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="G">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR">y</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">33</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="math_arithmetic">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR">x</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get">
                                <field name="VAR">y</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">16</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <comment pinned="false" w="340" h="170">Repeat the body with x taking each value from the start to the end, using the given step. Array indices start at zero.</comment>
              </block>
            </statement>
            <next>
              <block type="st_image_finish">
                <field name="DEVICE">image_card</field>
                <next>
                  <block type="controls_if">
                    <value name="IF0">
                      <block type="st_image_ok">
                        <field name="DEVICE">image_card</field>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="inout_digital_write">
                        <field name="PIN">6</field>
                        <field name="STAT">HIGH</field>
                        <comment pinned="false" w="340" h="160">Drive this output LOW or HIGH. This controls the connected digital signal; it does not produce a variable analog voltage.</comment>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
            <comment pinned="false" w="340" h="170">Repeat the body with y taking each value from the start to the end, using the given step. Array indices start at zero.</comment>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
