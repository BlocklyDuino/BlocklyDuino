<xml>
  <block type="music_buzzer" x="25" y="25">
    <mutation uid="beep38" />
    <field name="NAME">speaker</field>
    <field name="PIN">4</field>
    <field name="ENGINE">IRQ</field>
    <comment pinned="false" w="480" h="240">Purpose: Start a nonblocking note on a named passive buzzer while the main loop remains available for other tasks.
Wiring: Passive buzzer: PIN D4; digital write: PIN D13. Common GND; use each module’s required supply.
Try: Change the beep duration while the LED continues its separate task.</comment>
  </block>
  <block type="arduino_setup_section" x="25" y="130">
    <statement name="DO">
      <block type="music_note">
        <field name="DEVICE">beep38</field>
        <value name="HZ">
          <block type="music_pitch">
            <field name="PITCH">880</field>
          </block>
        </value>
        <value name="MS">
          <block type="math_number">
            <field name="NUM">500</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="arduino_loop_section" x="25" y="290">
    <statement name="DO">
      <block type="inout_digital_write">
        <field name="PIN">13</field>
        <field name="STAT">HIGH</field>
        <comment pinned="false" w="340" h="160">Drive this output LOW or HIGH. This controls the connected digital signal; it does not produce a variable analog voltage.</comment>
      </block>
    </statement>
  </block>
</xml>
